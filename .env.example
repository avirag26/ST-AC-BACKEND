NODE_ENV=development
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PORT=4000

# Auth
JWT_SECRET=stac-dev-secret-change-me
JWT_ACCESS_SECRET=stac-dev-access-secret
JWT_REFRESH_SECRET=stac-dev-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed CEO (used by prisma db seed)
SEED_CEO_PHONE=9999999999
SEED_CEO_EMAIL=ceo@straightline.academy
SEED_CEO_PASSWORD=Ceo@12345

# PostgreSQL
DATABASE_URL=postgresql://stac:stac_secret@localhost:5432/stac_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# S3 / MinIO (local S3-compatible storage)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=stac-uploads
S3_FORCE_PATH_STYLE=true

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004
