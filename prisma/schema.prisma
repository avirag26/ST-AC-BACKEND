// Straight Line Academy — Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CEO
  HOME_TUTOR
  OFFLINE_TUTOR
  PARENT
  STUDENT
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
}

enum SalaryStatus {
  PENDING
  CREDITED
}

enum SessionMode {
  ONLINE
  OFFLINE
}

enum SessionStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

/// Home-tutor online session progress
enum JourneyStep {
  NOT_STARTED
  LEFT_HOME
  REACHED
  CLASS_STARTED
  STOPPED
}

enum JourneyEventKind {
  CHECKPOINT
  LIVE_PING
}

model User {
  id               String          @id @default(cuid())
  phone            String?         @unique
  email            String          @unique
  passwordHash     String
  fullName         String
  dob              DateTime?
  role             UserRole
  status           UserStatus      @default(PENDING)
  rejectionReason  String?
  mustChangePassword Boolean       @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  tutorProfile     TutorProfile?
  parentProfile    ParentProfile?
  studentProfile   Student?
  refreshTokens    RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model TutorProfile {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects      String[]
  classes       String[]
  documentsNote String?
  salaryStatus  SalaryStatus @default(PENDING)
  batches       Batch[]
  sessions      Session[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

/// Managed by CEO — used in tutor registration dropdowns
model Subject {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Managed by CEO — e.g. Class 1 … Class 12
model ClassGrade {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  batches   Batch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// CEO-created parent account (login via email)
model ParentProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Student under a parent. Login is the parent's email (no separate student account).
model Student {
  id        String         @id @default(cuid())
  fullName  String
  userId    String?        @unique
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  parentId  String
  parent    ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  className   String?
  batches     BatchStudent[]
  sessions    Session[]
  attendance  Attendance[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([parentId])
}

/// Offline center batch under a class grade (CEO-managed)
model Batch {
  id             String         @id @default(cuid())
  name           String
  classGradeId   String
  classGrade     ClassGrade     @relation(fields: [classGradeId], references: [id], onDelete: Restrict)
  tutorProfileId String?
  tutorProfile   TutorProfile?  @relation(fields: [tutorProfileId], references: [id], onDelete: SetNull)
  isActive       Boolean        @default(true)
  students       BatchStudent[]
  sessions       Session[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([classGradeId])
  @@index([tutorProfileId])
}

model BatchStudent {
  id        String   @id @default(cuid())
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([batchId, studentId])
  @@index([studentId])
}

/// CEO-scheduled class session (online home or offline center)
model Session {
  id             String        @id @default(cuid())
  title          String?
  mode           SessionMode
  status         SessionStatus @default(SCHEDULED)
  subjectName    String?
  startsAt       DateTime
  endsAt         DateTime
  notes          String?
  tutorProfileId String
  tutorProfile   TutorProfile  @relation(fields: [tutorProfileId], references: [id], onDelete: Restrict)
  batchId        String?
  batch          Batch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
  studentId      String?
  student        Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  attendance     Attendance[]
  journey        SessionJourney?
  journeyEvents  JourneyLocationEvent[]
  classReport    ClassReport?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tutorProfileId])
  @@index([batchId])
  @@index([studentId])
  @@index([startsAt])
  @@index([mode, status])
}

/// Home tutor class journey: leave home → reach → start → stop
model SessionJourney {
  id               String      @id @default(cuid())
  sessionId        String      @unique
  session          Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  step             JourneyStep @default(NOT_STARTED)
  leftHomeAt       DateTime?
  leftHomeLat      Float?
  leftHomeLng      Float?
  reachedAt        DateTime?
  reachedLat       Float?
  reachedLng       Float?
  classStartedAt   DateTime?
  classStartedLat  Float?
  classStartedLng  Float?
  stoppedAt        DateTime?
  stoppedLat       Float?
  stoppedLng       Float?
  events           JourneyLocationEvent[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

/// Stored journey GPS trail (checkpoints + live pings) for CEO history
model JourneyLocationEvent {
  id         String           @id @default(cuid())
  sessionId  String
  session    Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  journeyId  String?
  journey    SessionJourney?  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  kind       JourneyEventKind
  step       JourneyStep
  lat        Float?
  lng        Float?
  recordedAt DateTime         @default(now())

  @@index([sessionId, recordedAt])
  @@index([journeyId])
  @@index([kind])
}

/// Home tutor class report (fill at stop or later). PDF generated on demand.
model ClassReport {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  topicsCovered  String
  homework       String?
  studentNotes   String?
  performance    String?
  nextPlan       String?
  filledAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Per-student mark for an offline session. Unmarked = Absent for parent view.
model Attendance {
  id             String           @id @default(cuid())
  sessionId      String
  session        Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status         AttendanceStatus
  markedByUserId String?
  markedAt       DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId])
}
